# Local demo credentials (localStorage demo — not PostgreSQL). Vite exposes VITE_* to browser.
# For production PostgreSQL, set DATABASE_URL and configure server-side auth (see schema.sql).
# Demo defaults if env empty: Admin@123 / Employee@123 — click demo buttons on login.
VITE_DEMO_ADMIN_PASSWORD=Admin@123
VITE_DEMO_EMPLOYEE_PASSWORD=Employee@123
# Example PostgreSQL (uncomment when backend is wired):
# DATABASE_URL=postgresql://dayflow:postgres@localhost:5432/dayflow
